# Copy this file to ".env" at the repository root and fill in your key.
# ".env" is gitignored; never commit a real key.

# Required for live replies. Without it the app runs, and chat answers 503.
OPENAI_API_KEY=

# Any Responses model with function calling. gpt-6-luna is cheap and fast
# (0.10 / 0.50 USD per 1M input / output tokens in September 2026).
OPENAI_MODEL=gpt-6-luna

# Optional: send runs to the OpenAI Traces dashboard (off by default). The second switch also
# puts model and tool inputs/outputs in the trace; it has no effect without the first.
HOTEL_TRACING_ENABLED=false
HOTEL_TRACING_SENSITIVE_DATA=false
# Optional: keep model responses on the provider (30 days) so the trace view can open them.
# History still comes only from the local session.
HOTEL_RESPONSES_STORE=false
